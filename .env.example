# Copy this file to .env and fill in the values you need.
# None of this is required to run the app — without it, the narrative
# checkbox in the UI shows an explanatory message instead of a summary,
# and the local TensorFlow classifier is used on its own.

# Which provider to use: "ollama", "openai", "anthropic" or "groq". Leave blank
# to disable both the narrative summary and the classification fallback.
LLM_PROVIDER=

# --- Ollama (local, no API key, nothing leaves this machine) ---
# Make sure `ollama serve` is running and you've pulled a model, e.g.
# `ollama pull llama3.1`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Seconds to wait for an Ollama reply. Raise it (e.g. 300) if data
# augmentation times out on a slow CPU.
# OLLAMA_TIMEOUT=120

# --- OpenAI (external API) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (external API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Groq (external API, OpenAI-compatible) ---
# Model ids: GET https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Seconds to wait for a Groq reply (default 30).
# GROQ_TIMEOUT=30

# Whether a low-confidence dilemma automatically gets a second opinion
# from the LLM classifier (see engine/advisor.py). Defaults to "true"
# automatically when LLM_PROVIDER=ollama (free, local, no reason not to),
# and "false" for openai/anthropic/groq (to avoid unexpected per-call costs).
# Uncomment to override that default explicitly:
# LLM_CLASSIFICATION_FALLBACK=true

# --- Tavily (optional live web search for the "Recent sources" section) ---
# Free account, no credit card: https://www.tavily.com — 1,000 search
# credits/month. Without this, the "search the web for recent sources"
# checkbox in the UI shows a clear explanatory message instead of results.
TAVILY_API_KEY=

